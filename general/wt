#!/usr/bin/env ruby
# wt — get around the worktree layout <worktree_root>/<tree>/<repo>: a tree is one name that
# spans every repository, so the checkouts under it are the set you work on together. Every
# repo in a fresh tree sits detached on origin/HEAD, the way work starts before a branch.
#
#   wt                              in a tree: that tree, its repos, what each has checked
#                                   out and its git status; anywhere else: every tree
#   wt --name                       the name of the tree you are in, on its own
#   wt --root-path                  where the tree you are in lives, on its own
#   wt list                      l  every tree name
#   wt list-repos               lr  every tree, its repos, what each has checked out, and
#                                   whether it has changed or untracked files. Each tree and
#                                   each repo comes with a number to hand to wt path. A
#                                   detached repo shows as origin when it is on origin/HEAD,
#                                   stale when it is not
#                                   On a terminal wide enough, wt and wt list-repos add the
#                                   changed and untracked files, dimmed, cut short with … +N
#                                   when they do not all fit
#   wt path [TREE [REPO]]        p  where a tree lives, or one repo in it; with no TREE, the
#                                   path of every tree, one per line
#   wt path INDEX                p  the tree or repo that number stands for in wt list-repos.
#                                   A tree named like a number is still that tree
#   wt repo-paths [TREE]        rp  the repos of a tree, space separated on one line, to
#                                   hand to something else
#   wt main-repo-paths         mrp  the main working copies the worktrees are cut from,
#                                   the same way
#   wt add TREE                  a  make TREE, every repo in it detached on origin/HEAD
#   wt update [TREE]             u  cut the worktrees a tree is missing; with no TREE, every
#                                   tree there is
#   wt update-detached [TREE]   ud  the repos there sitting detached: fetch, then detach
#                                   again on origin/HEAD. --all for every tree
#   wt reset-to-head [TREE]    rth  every repo there, branch or not: fetch, then detach on
#                                   origin/HEAD. One with uncommitted changes is left alone;
#                                   --force throws the changes away. Branches stay as they are
#   wt remove TREE [--force]    rm  take TREE and the worktrees in it away
#   wt prune                    pr  in every repository, forget the worktrees whose
#                                   directories are no longer there
#   wt config                    c  the .wt.yml in force, verbatim
#   wt init                      i  write a .wt.yml here, with the shape filled in
#
# The config is the first .wt.yml at or above the cwd, looking no higher than $HOME:
#
#   worktree_root: ~/trees
#   repositories:
#     repo-1: ~/dev/repo-1
#     repo-2: ~/dev/repo-2
#
# repositories maps the directory name a repo gets inside a tree to the working copy its
# worktrees are cut from. Paths are ~-expanded, and a relative one is read off the config's
# own directory. origin/HEAD is whatever branch origin calls its default; a repo without
# one is an error, and wt says the git remote command that sets it.

# frozen_string_literal: true

require 'fileutils'
require 'io/console'
require 'open3'
require 'yaml'

$stdout.sync = true

Config = Struct.new(:path, :root, :repos)

ALIASES = {
  'l' => 'list', 'lr' => 'list-repos', 'p' => 'path', 'a' => 'add',
  'u' => 'update', 'ud' => 'update-detached', 'rth' => 'reset-to-head',
  'rm' => 'remove', 'pr' => 'prune', 'c' => 'config', 'i' => 'init',
  'rp' => 'repo-paths', 'mrp' => 'main-repo-paths'
}.freeze

COMMANDS = ALIASES.values.freeze

def die(message)
  warn "wt: #{message}"
  exit 1
end

def usage
  lines = File.readlines(__FILE__).drop(1).take_while { |line| line.start_with?('#') }
  lines.each { |line| puts line.sub(/\A# ?/, '').rstrip }
end

# --- the config ------------------------------------------------------------------------

# The nearest .wt.yml, walking up from the cwd. $HOME is as far as the walk goes: a config
# above it would be one shared with every other user of the machine, which is not a thing.
def load_config
  dir = File.realpath(Dir.pwd)
  home = File.expand_path('~')
  loop do
    candidate = File.join(dir, '.wt.yml')
    return read_config(candidate) if File.file?(candidate)

    parent = File.dirname(dir)
    break if dir == home || parent == dir

    dir = parent
  end
  die "no .wt.yml at or above #{Dir.pwd}"
end

def read_config(path)
  data = begin
    YAML.safe_load_file(path) || {}
  rescue StandardError => e
    die "#{path}: #{e.message}"
  end
  die "#{path}: not a mapping" unless data.is_a?(Hash)

  root = data['worktree_root'].to_s
  die "#{path}: no worktree_root" if root.empty?

  repos = data['repositories']
  die "#{path}: no repositories" unless repos.is_a?(Hash) && !repos.empty?

  base = File.dirname(path)
  Config.new(path, resolve(root, base), repos.to_h { |name, repo| [name.to_s, resolve(repo, base)] })
end

def resolve(path, base)
  path = path.to_s
  path.start_with?('~', '/') ? File.expand_path(path) : File.expand_path(path, base)
end

# --- git -------------------------------------------------------------------------------

# Output and whether it worked, both at once — nothing here wants the two apart, and git
# says what went wrong on stderr.
def git(dir, *args)
  out, status = Open3.capture2e('git', '-C', dir, *args)
  [out.strip, status.success?]
rescue SystemCallError => e
  [e.message, false]
end

# What the checkout at the given path has on HEAD: the branch it is on, the commit it sits
# on detached, or '-' when git will not tell us — not a checkout, or not a repo at all.
def head_state(path)
  return 'missing' unless Dir.exist?(path)

  head, ok = git(path, 'symbolic-ref', '--short', 'HEAD')
  return head if ok

  head, ok = git(path, 'rev-parse', '--short', 'HEAD')
  ok ? "detached #{head}" : '-'
end

# head_state as wt and wt list-repos show it: a detached checkout is origin when it sits on
# the commit origin/HEAD points at, stale when it does not. nil when the repo has no
# origin/HEAD to hold it against.
def shown_head(path)
  state = head_state(path)
  return state unless state.start_with?('detached ')

  origin, ok = git(path, 'rev-parse', '--verify', '--quiet', 'refs/remotes/origin/HEAD')
  return nil unless ok

  head, = git(path, 'rev-parse', 'HEAD')
  "#{head == origin ? 'origin' : 'stale'} #{state.delete_prefix('detached ')}"
end

# What the checkout has that no commit does: tracked files changed, files git does not know
# about, or clean, and the names of those files. Empty when there is no checkout to ask —
# head_state has said so already.
def work_state(path)
  return ['', []] unless Dir.exist?(path)

  out, ok = git(path, 'status', '--porcelain')
  return ['', []] unless ok

  lines = out.lines
  untracked = lines.count { |line| line.start_with?('??') }
  changed = lines.size - untracked
  parts = []
  parts << "#{changed} changed" if changed.positive?
  parts << "#{untracked} untracked" if untracked.positive?
  # git() strips the output, which can eat the first line's leading space, so take the
  # path as whatever follows the status letters rather than at a fixed column.
  # Changed files first, then untracked, so a truncated list keeps what matters most.
  files = lines.partition { |line| !line.start_with?('??') }.flatten.map { |line| line.chomp.sub(/\A\s*\S+\s+/, '') }
  [parts.empty? ? 'clean' : parts.join(', '), files]
end

# How many columns the terminal has, or nil when stdout is not one — a pipe or a file gets
# no layout that depends on a screen. Asked once, as wt starts printing.
def terminal_width
  return nil unless $stdout.tty?

  cols = $stdout.winsize.last
  cols.positive? ? cols : nil
rescue SystemCallError
  nil
end

# The files in as many columns as there are: as many whole names as fit, then how many more
# there are, and a name that is too long alone loses its front, the end being what tells
# files apart.
def fit_files(files, width)
  return '' if files.empty? || width < 1

  all = files.join(', ')
  return all if all.length <= width

  shown = []
  files.each_with_index do |file, i|
    tail = i == files.size - 1 ? '' : ", … +#{files.size - i - 1}"
    break if (shown + [file]).join(', ').length + tail.length > width

    shown << file
  end
  return "#{shown.join(', ')}, … +#{files.size - shown.size}" unless shown.empty?

  more = files.size > 1 ? " +#{files.size - 1}" : ''
  room = width - more.length - 1
  room.positive? ? "…#{files.first[-room..]}#{more}" : '…'
end

# The ref a detached checkout hangs off, and the commit it is on, short — nil when there is
# none. That is origin/HEAD, which names origin's default branch, main or master or whatever
# it is.
def default_ref(dir)
  head, ok = git(dir, 'rev-parse', '--verify', '--quiet', '--short', 'refs/remotes/origin/HEAD')
  ok ? ['refs/remotes/origin/HEAD', head] : nil
end

# What to say when a repo has no origin/HEAD: the command that sets it.
def no_origin_head(dir)
  "no origin/HEAD — set it with: git -C #{dir} remote set-head origin --auto"
end

def repo?(dir)
  git(dir, 'rev-parse', '--git-dir').last
end

# The last line of what git said, which is where it says what went wrong.
def last_line(out)
  out.lines.last&.strip
end

# The repository a checkout belongs to, named by the git dir all its worktrees share — two
# checkouts with the same key fetch into the one object store.
def repo_key(dir)
  common, ok = git(dir, 'rev-parse', '--git-common-dir')
  ok ? File.expand_path(common, dir) : dir
end

# Fetch the repositories the given checkouts belong to: once each, however many worktrees of
# one there are — they share the one object store, so a second fetch would be for nothing —
# and all at the same time, since a fetch is mostly waiting on the network. Whether it went
# through, by checkout.
def fetch_all(dirs)
  repos = dirs.uniq.group_by { |dir| repo_key(dir) }.values
  threads = repos.map { |group| Thread.new { git(group.first, 'fetch', '--quiet', 'origin').last } }
  repos.zip(threads).flat_map { |group, thread| group.map { |dir| [dir, thread.value] } }.to_h
end

# --- the layout ------------------------------------------------------------------------

# The trees under the root: its directories, minus the ones whose name starts with a dot —
# a dot directory is bookkeeping somebody keeps beside the trees, not one of them.
def trees(config)
  return [] unless Dir.exist?(config.root)

  undotted_dirs(config.root).sort
end

def undotted_dirs(dir)
  Dir.children(dir)
     .reject { |name| name.start_with?('.') }
     .select { |name| Dir.exist?(File.join(dir, name)) }
end

# The tree the cwd is in, read off the path itself — nil outside the layout.
def current_tree(config)
  current_spot(config)&.first
end

# The tree the cwd is in and the directory in it, read off the path itself: [tree, repo],
# the repo nil in the tree's own directory. nil outside the layout.
def current_spot(config)
  root = File.realpath(config.root)
  pwd = File.realpath(Dir.pwd)
  return nil unless pwd.start_with?("#{root}/")

  pwd.delete_prefix("#{root}/").split('/').take(2).then { |tree, repo| [tree, repo] }
rescue SystemCallError
  nil
end

# The repos of a tree: the configured ones in the order the config gives them, then whatever
# else is sitting in there — a directory nobody configured is still yours to know about.
# Dot directories stay out of it, the same as among the trees: the .<tree> marker
# zed-open-wts keeps in a tree is not a repo.
def repo_entries(config, tree)
  dir = File.join(config.root, tree)
  present = Dir.exist?(dir) ? undotted_dirs(dir) : []
  (config.repos.keys + (present - config.repos.keys).sort).map { |name| [name, File.join(dir, name)] }
end

def require_tree(config, tree)
  die "no tree named #{tree}" unless Dir.exist?(File.join(config.root, tree))

  tree
end

# The trees a command that can mean one of them, or all, is aimed at.
def targets(config, tree, all, verb)
  die 'say a tree or --all, not both' if tree && all
  return every_tree(config) if all
  return [require_tree(config, tree)] if tree

  here = current_tree(config)
  die "not in a tree — say 'wt #{verb} TREE' or --all" unless here

  [here]
end

def every_tree(config)
  trees(config).tap { |list| die "no trees under #{config.root}" if list.empty? }
end

# --- saying what happened ----------------------------------------------------------------

def print_notes(notes, indent: '')
  width = notes.map { |name, _| name.length }.max || 0
  notes.each { |name, note| puts "#{indent}#{name.ljust(width)}  #{note}" }
end

# Each repo of the given trees, what it has checked out and whether it has work in it, by
# tree. Every checkout is asked at the same time — they do not depend on one another, and a
# git status on a big repo is worth not waiting out one after another. A detached repo with
# no origin/HEAD stops it all: there is nothing to say whether it is stale.
def tree_rows(config, list)
  threads = list.to_h do |tree|
    [tree, repo_entries(config, tree).map { |name, path| Thread.new { [name, path, shown_head(path), *work_state(path)] } }]
  end
  rows = threads.transform_values { |repos| repos.map(&:value) }
  _, path, = rows.values.flatten(1).find { |_, _, head, *| head.nil? }
  die "#{path}: #{no_origin_head(path)}" if path

  rows.transform_values { |repos| repos.map { |name, _, head, work, files| [name, head, work, files] } }
end

# Every tree and every repo in it, numbered from 1 in the order wt list-repos prints them —
# one count through both, so a number is one thing, and wt path takes it in place of a tree
# or a tree and a repo. Keyed by [tree, repo], the repo nil for the tree itself. Read off the
# directories alone, so a number means the same thing wherever the listing was printed from.
def numbered(config)
  entries = trees(config).flat_map do |tree|
    [[tree, nil, File.join(config.root, tree)], *repo_entries(config, tree).map { |name, path| [tree, name, path] }]
  end
  entries.each.with_index(1).to_h { |entry, index| [entry.take(2), [index, entry.last]] }
end

# Each tree, its repos, what each has checked out and whether it has work in it, each tree
# and repo under its number. The columns line up across all the trees printed, not just
# within one, so they read as one table. The line for where the cwd is goes in bold: the
# repo it is in, or the tree when it is in none of the tree's repos.
MIN_FILES_WIDTH = 20

def print_trees(config, list)
  rows = tree_rows(config, list)
  numbers = numbered(config)
  here = current_spot(config)
  here = [here.first, nil] if here && !rows[here.first]&.any? { |name, *| name == here.last }
  line = ->(key, text) { puts(key == here && $stdout.tty? ? "\e[1m#{text}\e[0m" : text) }
  all = rows.values.flatten(1)
  index_width = numbers.values.map { |index, _| index.to_s.length }.max || 0
  name_width = all.map { |name, *| name.length }.max || 0
  head_width = all.map { |_, head, *| head.length }.max || 0
  work_width = all.map { |_, _, work, _| work.length }.max || 0
  # The files column takes what the terminal has left after the others, and only when that
  # is enough to say something with.
  term = terminal_width
  files_width = term ? term - (index_width + name_width + head_width + work_width + 12) : 0
  files_width = 0 if files_width < MIN_FILES_WIDTH
  index = ->(tree, name) { numbers.dig([tree, name], 0).to_s.rjust(index_width) }
  rows.each do |tree, repos|
    line.([tree, nil], "#{index.(tree, nil)}  #{tree}")
    repos.each do |name, head, work, files|
      cells = "  #{index.(tree, name)}  #{name.ljust(name_width)}  #{head.ljust(head_width)}  #{work.ljust(work_width)}"
      # Dim, not a colour: it is lighter than the text around it on a dark background and on a light one.
      cells += "  \e[2m#{fit_files(files, files_width)}\e[22m" if files_width.positive? && files.any?
      line.([tree, name], cells.rstrip)
    end
  end
end

# Print what a command had to say, by tree, and exit 1 if any of it went wrong. A tree's name
# goes above its lines only when there is more than one tree to tell them apart.
def report(results, failed)
  results.each do |tree, notes|
    next if notes.empty?

    puts tree if results.size > 1
    print_notes(notes, indent: results.size > 1 ? '  ' : '')
  end
  exit 1 if failed
end

# --- one repo at a time --------------------------------------------------------------------

# Work that waits on a fetch: the checkout whose repository has to be fetched first, and
# what to do once it has been.
Pending = Struct.new(:dir, :work)

# Do one thing to every repo of the given trees, in two passes. The block looks each repo
# over and answers with its [note, ok] when that is all there is to it, nil when there is
# nothing to say, or a Pending. Every repository a Pending names is then fetched in one go —
# see fetch_all — and the work runs wherever its fetch went through. What came of it, by
# tree as [name, note, ok], and whether anything failed.
def across_repos(config, list)
  plans = list.to_h { |tree| [tree, repo_entries(config, tree).map { |name, path| [name, yield(name, path)] }] }
  fetched = fetch_all(plans.values.flatten(1).filter_map { |_, plan| plan.dir if plan.is_a?(Pending) })
  results = plans.transform_values do |repos|
    repos.filter_map { |name, plan| [name, *settle(plan, fetched)] if plan }
  end
  [results, results.values.flatten(1).any? { |_, _, ok| !ok }]
end

# A repo's [note, ok], doing the work a Pending is waiting on once its fetch is in.
def settle(plan, fetched)
  return plan unless plan.is_a?(Pending)

  fetched[plan.dir] ? plan.work.call : ['fetch failed', false]
end

# Cut one worktree, detached where the repo's default branch is.
def cut_worktree(source, path)
  return ["no repository at #{source}", false] unless repo?(source)

  Pending.new(source, lambda do
    ref, head = default_ref(source)
    return [no_origin_head(source), false] unless ref

    out, ok = git(source, 'worktree', 'add', '--detach', path, ref)
    ok ? ["detached #{head}", true] : ["worktree add failed: #{last_line(out)}", false]
  end)
end

# Catch one checkout up with origin. Only a repo sitting on a detached commit is touched — a
# repo on a branch is work in the middle of, so it is left alone and said so.
def redetach(path)
  state = head_state(path)
  return ["left alone, on #{state}", true] unless state.start_with?('detached ')

  Pending.new(path, -> { detach_on_default(path, state) })
end

# Put one checkout back on origin, whatever it had checked out. The branch it was on stays
# where it is, commits and all — only the checkout moves off it. Uncommitted changes are
# the one thing that would be lost, so a checkout with any is left alone unless forced.
def reset_to_head(path, force)
  state = head_state(path)
  return ['not a checkout', false] if state == '-'

  dirty, = git(path, 'status', '--porcelain', '--untracked-files=no')
  return ["left alone, uncommitted changes on #{state}", false] unless dirty.empty? || force

  Pending.new(path, -> { detach_on_default(path, state, force:) })
end

# Detach a checkout on its repo's default ref, saying where it came from.
def detach_on_default(path, state, force: false)
  ref, head = default_ref(path)
  return [no_origin_head(path), false] unless ref

  args = %w[checkout --quiet --detach]
  args << '--force' if force
  out, ok = git(path, *args, ref)
  return ["checkout failed: #{last_line(out)}", false] unless ok

  was = state.delete_prefix('detached ')
  [was == head ? "already on #{head}" : "#{was} -> #{head}", true]
end

# Take one worktree away. git refuses one with work in it, which is the point — that refusal
# is all that stands between a stray 'wt rm' and an afternoon. --force overrules it, and
# takes down a directory git will not own to at all.
def drop_worktree(source, path, force)
  args = %w[worktree remove]
  args << '--force' if force
  out, ok = git(source, *args, path)
  return ['removed', true] if ok
  return [head_state(path) == '-' ? 'not a worktree' : last_line(out) || 'remove failed', false] unless force

  FileUtils.rm_rf(path)
  git(source, 'worktree', 'prune')
  ['removed by force', true]
end

# Forget the worktrees of one repository whose directories are gone. git keeps a record per
# worktree it cut, and a tree deleted by hand leaves that record behind, still holding on to
# the branch it had checked out; pruning is what drops it.
def prune_worktrees(source)
  return ["no repository at #{source}", false] unless repo?(source)

  out, ok = git(source, 'worktree', 'prune', '--verbose')
  return ["prune failed: #{last_line(out)}", false] unless ok

  gone = out.lines.count { |line| !line.strip.empty? }
  [gone.zero? ? 'nothing stale' : "forgot #{gone}", true]
end

# --- commands --------------------------------------------------------------------------

# The worktrees of the given trees that are missing, cut. Reports a line per repo worth
# saying something about — with report_existing, that is every configured repo; without it,
# only what changed or broke.
def fill_trees(config, list, report_existing:)
  across_repos(config, list) do |name, path|
    source = config.repos[name]
    next unless source
    next(report_existing ? [head_state(path), true] : nil) if Dir.exist?(path)

    cut_worktree(source, path)
  end
end

# The tree named, or else the one the cwd is in.
def tree_or_here(config, tree, verb)
  return require_tree(config, tree) if tree

  current_tree(config) || die("not in a tree — say 'wt #{verb} TREE'")
end

def cmd_add(config, args)
  die 'add takes one tree name; see wt --help' unless args.size == 1

  tree = args.first
  die 'a tree name is one directory name, not a path' if tree.include?('/')

  FileUtils.mkdir_p(File.join(config.root, tree))
  report(*fill_trees(config, [tree], report_existing: true))
end

def cmd_update(config, args, all)
  die 'update takes at most one tree name; see wt --help' if args.size > 1
  die 'say a tree or --all, not both' if args.first && all

  list = args.first ? [require_tree(config, args.first)] : every_tree(config)
  report(*fill_trees(config, list, report_existing: false))
end

def cmd_update_detached(config, args, all)
  die 'update-detached takes at most one tree name; see wt --help' if args.size > 1

  list = targets(config, args.first, all, 'update-detached')
  report(*across_repos(config, list) { |_, path| redetach(path) if Dir.exist?(path) })
end

def cmd_reset_to_head(config, args, force)
  die 'reset-to-head takes at most one tree name; see wt --help' if args.size > 1

  tree = tree_or_here(config, args.first, 'reset-to-head')
  report(*across_repos(config, [tree]) { |_, path| reset_to_head(path, force) if Dir.exist?(path) })
end

def cmd_remove(config, args, force)
  die 'remove takes one tree name; see wt --help' unless args.size == 1

  tree = require_tree(config, args.first)
  tree_dir = File.join(config.root, tree)
  results, failed = across_repos(config, [tree]) do |name, path|
    drop_worktree(config.repos[name] || path, path, force) if Dir.exist?(path)
  end
  print_notes(results[tree])

  die "#{tree_dir} left in place" if failed

  drop_tree_dir(tree_dir, force)
  puts "removed #{tree_dir}"
end

# Empty dot directories in the tree — the marker zed-open-wts leaves there — go without a
# --force; there is nothing in them to lose.
def drop_tree_dir(tree_dir, force)
  return FileUtils.rm_rf(tree_dir) if force

  Dir.children(tree_dir).each do |name|
    path = File.join(tree_dir, name)
    Dir.rmdir(path) if name.start_with?('.') && Dir.exist?(path) && Dir.empty?(path)
  end
  return Dir.rmdir(tree_dir) if Dir.empty?(tree_dir)

  die "#{tree_dir} is not empty — clear it yourself, or say --force"
end

# Prune every repository the config names. Nothing you still have is lost to it: a record
# only goes when the directory it names is already gone, so this is the tidying up after
# trees that were deleted by hand rather than with wt remove.
def cmd_prune(config, args)
  die 'prune takes no arguments; see wt --help' unless args.empty?

  failed = false
  notes = config.repos.map do |name, source|
    note, ok = prune_worktrees(source)
    failed ||= !ok
    [name, note]
  end
  print_notes(notes)
  exit 1 if failed
end

TEMPLATE = <<~YML
  # .wt.yml — what wt goes by. The nearest one at or above the directory you are in wins.

  # Where the trees live: every tree is a directory in here, and every repo is a directory
  # in that. wt add makes them; nothing else needs to.
  worktree_root: ~/trees

  # The directory name a repo gets inside a tree, and the working copy its worktrees are
  # cut from. Paths are ~-expanded, and a relative one is read off this file's own
  # directory. A fresh worktree comes up detached on origin/HEAD, origin's default branch;
  # a repo without one needs a 'git remote set-head origin --auto' first.
  repositories:
    repo-1: ~/dev/repo-1
    repo-2: ~/dev/repo-2
YML

# Lay down a config to fill in. Nothing is guessed from what is lying around: which repos
# belong together is the one thing only you know.
def cmd_init(args)
  die 'init takes no arguments; see wt --help' unless args.empty?

  path = File.join(Dir.pwd, '.wt.yml')
  die "#{path} is already there" if File.exist?(path)

  File.write(path, TEMPLATE)
  puts "wrote #{path}"
end

def cmd_path(config, args)
  die 'path takes a tree and a repo at most; see wt --help' if args.size > 2

  return trees(config).each { |tree| puts File.join(config.root, tree) } if args.empty?
  return puts path_of_one(config, args.first) if args.size == 1

  path = File.join(config.root, args[0], args[1])
  die "no such worktree: #{path}" unless Dir.exist?(path)

  puts path
end

# A tree by name, or else a tree or repo by its number in wt list-repos. The tree wins: a number is
# only ever looked up when no tree goes by it.
def path_of_one(config, arg)
  return File.join(config.root, arg) if Dir.exist?(File.join(config.root, arg))
  return File.join(config.root, require_tree(config, arg)) unless arg.match?(/\A\d+\z/)

  _, path = numbered(config).values.find { |index, _| index == arg.to_i }
  die "no tree named #{arg}, and nothing numbered #{arg}" unless path
  die "no such worktree: #{path}" unless Dir.exist?(path)

  path
end

# The repos of a tree on one line, space separated, for something else to take in one go —
# an editor opening the whole set, say. Only the ones actually there are named.
def cmd_repo_paths(config, args)
  die 'repo-paths takes at most one tree name; see wt --help' if args.size > 1

  tree = tree_or_here(config, args.first, 'repo-paths')

  paths = repo_entries(config, tree).filter_map { |_, path| path if Dir.exist?(path) }
  die "no repos in #{tree}" if paths.empty?

  puts paths.join(' ')
end

# The working copies the worktrees are cut from — the configured repositories themselves,
# main working trees rather than any tree's. Same one line as repo-paths, and the same rule:
# only the ones actually there are named.
def cmd_main_repo_paths(config, args)
  die 'main-repo-paths takes no arguments; see wt --help' unless args.empty?

  paths = config.repos.values.select { |path| Dir.exist?(path) }
  die 'none of the configured repositories are there' if paths.empty?

  puts paths.join(' ')
end

# The tree the cwd is in and nothing else, for a prompt or a script to put the name to use.
def cmd_name(config)
  here = current_tree(config)
  die 'not in a tree' unless here

  puts here
end

# Where the tree the cwd is in lives, for a script to cd to before it works across the tree.
def cmd_root_path(config)
  here = current_tree(config)
  die 'not in a tree' unless here

  puts File.join(config.root, here)
end

def cmd_default(config, args)
  die 'too many arguments; see wt --help' unless args.empty?

  here = current_tree(config)
  return print_trees(config, [here]) if here

  print_trees(config, trees(config))
end

# --- dispatch --------------------------------------------------------------------------

argv = ARGV.dup
if argv.include?('-h') || argv.include?('--help')
  usage
  exit 0
end

flags, args = argv.partition { |arg| arg.start_with?('-') }
unknown = flags - %w[--all --force --name --root-path]
die "unknown option: #{unknown.first}; see wt --help" unless unknown.empty?

all = flags.include?('--all')
force = flags.include?('--force')
name = flags.include?('--name')
root_path = flags.include?('--root-path')

command = args.shift
command = ALIASES.fetch(command, command)
die "unknown command: #{command}; see wt --help" unless command.nil? || COMMANDS.include?(command)
die '--all is for update and update-detached' if all && !%w[update update-detached].include?(command)
die '--force is for remove and reset-to-head' if force && !%w[remove reset-to-head].include?(command)
die '--name goes on its own' if name && !(command.nil? && args.empty? && !root_path)
die '--root-path goes on its own' if root_path && !(command.nil? && args.empty?)

if command == 'init'
  cmd_init(args)
  exit 0
end

config = load_config

case command
when nil
  if name then cmd_name(config)
  elsif root_path then cmd_root_path(config)
  else cmd_default(config, args)
  end
when 'list' then trees(config).each { |tree| puts tree }
when 'list-repos' then print_trees(config, trees(config))
when 'path' then cmd_path(config, args)
when 'repo-paths' then cmd_repo_paths(config, args)
when 'main-repo-paths' then cmd_main_repo_paths(config, args)
when 'add' then cmd_add(config, args)
when 'update' then cmd_update(config, args, all)
when 'update-detached' then cmd_update_detached(config, args, all)
when 'reset-to-head' then cmd_reset_to_head(config, args, force)
when 'remove' then cmd_remove(config, args, force)
when 'prune' then cmd_prune(config, args)
when 'config' then print File.read(config.path)
end
