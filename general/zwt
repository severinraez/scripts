#!/usr/bin/env bash
# zwt — get around the worktree layout: <share>/worktrees/<repo>/<worktree>/<repo>, one repo
# apart, the way Zed makes them. A <worktree> name spans repos, so the worktrees sharing one
# are the group you work on together; this prints their paths so you can cd to them.
#
#   zwt                             in a worktree: every repo, and its path under the current
#                                   worktree; anywhere else: every worktree name there is
#   zwt paths [WORKTREE]            only the paths of that listing, space separated
#   zwt worktrees                   every worktree, its repos, and what each has checked out
#   zwt update-detached [WORKTREE]  the repos there sitting detached: fetch, then detach again
#                                   on origin/main
#   zwt WORKTREE REPO               path of worktrees/REPO/WORKTREE/REPO
#   zwt REPO                        the same, for the worktree the cwd is in
#
# Set ZWT_ROOT to the share to use it from outside the layout; otherwise the share is the
# nearest directory at or above the cwd that holds a worktrees/.

set -uo pipefail

die() { printf 'zwt: %s\n' "$1" >&2; exit 1; }

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

# The share the layout hangs off, walking up from the cwd: the parent of a worktrees/ we are
# standing inside, else the first ancestor that has one.
share_root() {
  [[ -n ${ZWT_ROOT:-} ]] && { printf '%s\n' "${ZWT_ROOT%/}"; return; }

  local dir=$PWD
  while [[ $dir != / ]]; do
    [[ ${dir##*/} == worktrees ]] && { printf '%s\n' "${dir%/*}"; return; }
    [[ -d $dir/worktrees ]] && { printf '%s\n' "$dir"; return; }
    dir=${dir%/*}
    [[ -z $dir ]] && dir=/
  done
  return 1
}

# The worktree the cwd is in, read off the path itself — empty outside the layout.
current_worktree() {
  local rel=${PWD#"$share/"}
  [[ $rel == "$PWD" || $rel != worktrees/*/* ]] && return
  rel=${rel#worktrees/*/}
  printf '%s\n' "${rel%%/*}"
}

repos() { ls -1 "$share/worktrees" 2>/dev/null; }

worktree_path() { printf '%s/worktrees/%s/%s/%s\n' "$share" "$2" "$1" "$2"; }

# Every repo's copy of the given worktree that exists, one per line.
existing_paths() {
  local repo path
  while read -r repo; do
    path=$(worktree_path "$1" "$repo")
    [[ -d $path ]] && printf '%s\n' "$path"
  done < <(repos)
}

# Every worktree name in the share, each one once however many repos have it.
worktree_names() {
  local repo
  while read -r repo; do
    ls -1 "$share/worktrees/$repo" 2>/dev/null
  done < <(repos) | sort -u
}

# What the checkout at the given path has on HEAD: the branch it is on, the commit it sits on
# detached, or '-' when git will not tell us — no checkout there, or not a repo at all.
head_state() {
  local head
  head=$(git -C "$1" symbolic-ref --short HEAD 2>/dev/null) &&
    { printf '%s\n' "$head"; return; }
  head=$(git -C "$1" rev-parse --short HEAD 2>/dev/null) &&
    { printf 'detached %s\n' "$head"; return; }
  printf -- '-\n'
}

case ${1:-} in -h | --help) usage; exit 0 ;; esac
[[ $# -gt 2 ]] && die "too many arguments; see zwt --help"

share=$(share_root) || die "no worktrees/ at or above $PWD — set ZWT_ROOT"
[[ -d $share/worktrees ]] || die "$share/worktrees does not exist"
worktree=$(current_worktree)

# The listing without the repo names, on one line, to hand to something else — Zed opening a
# whole set, say. Names a worktree of its own, so it reaches one you are not standing in. A
# repo called paths is shadowed: reach that with 'zwt WORKTREE paths'.
if [[ ${1:-} == paths ]]; then
  wanted=${2:-$worktree}
  [[ -n $wanted ]] || die "not in a worktree — say 'zwt paths WORKTREE'"
  mapfile -t found < <(existing_paths "$wanted")
  [[ ${#found[@]} -gt 0 ]] || die "no worktree named $wanted"
  printf '%s\n' "${found[*]}"
  exit 0
fi

# The whole share at a glance: each worktree, and under it the repos that are in on it with
# what they have checked out. A repo without a copy of the worktree is left out — here the
# point is what the set you would work on actually is. A repo called worktrees is shadowed:
# reach that with 'zwt WORKTREE worktrees'.
if [[ ${1:-} == worktrees ]]; then
  [[ $# -eq 1 ]] || die "worktrees takes no arguments; see zwt --help"
  while read -r name; do
    printf '%s\n' "$name"
    while read -r path; do
      printf '  %-18s %s\n' "${path##*/}" "$(head_state "$path")"
    done < <(existing_paths "$name")
  done < <(worktree_names)
  exit 0
fi

# Catch the repos of a set up with origin/main again. Only the ones sitting on a detached
# commit are touched — a repo on a branch is work in the middle of, so it is left alone and
# said so. A repo called update-detached is shadowed: reach that with
# 'zwt WORKTREE update-detached'.
if [[ ${1:-} == update-detached ]]; then
  wanted=${2:-$worktree}
  [[ -n $wanted ]] || die "not in a worktree — say 'zwt update-detached WORKTREE'"
  mapfile -t found < <(existing_paths "$wanted")
  [[ ${#found[@]} -gt 0 ]] || die "no worktree named $wanted"

  status=0
  for path in "${found[@]}"; do
    repo=${path##*/}
    state=$(head_state "$path")
    if [[ $state != detached\ * ]]; then
      printf '%-18s left alone, on %s\n' "$repo" "$state"
      continue
    fi

    if ! git -C "$path" fetch --quiet origin; then
      printf '%-18s fetch failed\n' "$repo"
      status=1
      continue
    fi
    if ! head=$(git -C "$path" rev-parse --short --verify origin/main 2>/dev/null); then
      printf '%-18s no origin/main\n' "$repo"
      status=1
      continue
    fi
    if ! git -C "$path" checkout --quiet --detach origin/main; then
      printf '%-18s checkout failed\n' "$repo"
      status=1
      continue
    fi
    printf '%-18s %s -> %s\n' "$repo" "${state#detached }" "$head"
  done
  exit $status
fi

if [[ $# -eq 0 ]]; then
  # In a worktree: the repos, and where each one's copy of this worktree lives. A repo that
  # has no worktree of that name is listed all the same, so you can see it is not in on it.
  if [[ -n $worktree ]]; then
    while read -r repo; do
      path=$(worktree_path "$worktree" "$repo")
      [[ -d $path ]] || path='-'
      printf '%-20s %s\n' "$repo" "$path"
    done < <(repos)
  else
    # Anywhere else there is no worktree to fix on, so just the names, each one once.
    worktree_names
  fi
  exit 0
fi

if [[ $# -eq 2 ]]; then
  target=$(worktree_path "$1" "$2")
else
  [[ -n $worktree ]] || die "not in a worktree — say 'zwt WORKTREE $1'"
  target=$(worktree_path "$worktree" "$1")
fi

[[ -d $target ]] || die "no such worktree: $target"
printf '%s\n' "$target"
